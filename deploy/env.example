# 이 파일을 서버의 ~/autolog-hyundai-2026/.env로 복사해 값을 채웁니다.
# 로컬 저장소에서 검증할 때는 deploy/.env입니다. 실제 .env는 Git에 넣지 않습니다.
# Compose용 dotenv 문법을 사용합니다. $, # 등이 들어가는 값은 작은따옴표로 감싸세요.

DB_NAME=autolog
DB_USERNAME=autolog
# 예: openssl rand -hex 32 로 생성한 별도 비밀번호. 반드시 채워야 합니다.
DB_PASSWORD=

# docs/contracts/rules.md: HS256 키는 32바이트 이상. DB 비밀번호와 다른 값으로 생성합니다.
# 현재 인증 로직은 미구현이며, 이 변수는 계약에 맞춰 전달할 준비를 해둔 것입니다.
JWT_SECRET=

# 실제 Pages 도메인/커스텀 도메인이 정해지면 추가하세요. 쉼표로 구분하고 경로/마지막 /는 넣지 않습니다.
# 예: https://autolog.pages.dev,http://localhost:5173
# 서버의 CORS_ALLOWED_ORIGINS 소비 코드도 구현되어 있어야 브라우저 호출이 허용됩니다.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Oracle 2 CPU / 약 12GiB 환경에서 시작할 제한값. 예약량이 아니라 컨테이너 사용 상한입니다.
API_MEMORY_LIMIT=1536m
API_CPUS=1.0
DB_MEMORY_LIMIT=512m
DB_CPUS=0.5

# 선택: JVM 설정을 바꾸려는 경우에만 주석을 해제합니다.
# JAVA_TOOL_OPTIONS='-XX:MaxRAMPercentage=70.0 -XX:InitialRAMPercentage=20.0 -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8'

# 이미지 버전은 deploy.sh/Actions가 AUTOLOG_API_IMAGE로 전달하고 .state/에 기록합니다.
# 이 파일에는 SSH 키, GitHub/GHCR 토큰을 넣지 않습니다.
