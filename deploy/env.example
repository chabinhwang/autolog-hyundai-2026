# 이 파일을 서버의 ~/autolog-hyundai-2026/.env로 복사해 값을 채웁니다.
# 로컬 저장소에서 검증할 때는 deploy/.env입니다. 실제 .env는 Git에 넣지 않습니다.
# Compose용 dotenv 문법을 사용합니다. $, # 등이 들어가는 값은 작은따옴표로 감싸세요.

DB_NAME=autolog
DB_USERNAME=autolog
# 예: openssl rand -hex 32 로 생성한 별도 비밀번호. 반드시 채워야 합니다.
DB_PASSWORD=

# 관리자 JWT(HS256) 서명 키. 32바이트 이상이어야 하며, 짧거나 비어 있으면 API가 시작하지 않습니다.
# 예: openssl rand -hex 32 로 생성. DB 비밀번호와 다른 값으로 만듭니다.
JWT_SECRET=
# 선택: 관리자 JWT 만료 시간(시간 단위). 기본 12 (docs/contracts D1)
JWT_EXPIRES_HOURS=12

# 대시보드 출처(CORS 허용 목록). 비어 있으면 API가 시작하지 않습니다.
# 실제 Pages 도메인/커스텀 도메인이 정해지면 추가하세요. 쉼표로 구분하고 경로/마지막 /는 넣지 않습니다.
# 예: https://autolog.pages.dev,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 선택: 현재 직원 동의 문서 버전 (docs/contracts D13). 차량 설정 내려받기 응답에 포함됩니다. 기본 2026-11-01
CONSENT_VERSION=2026-11-01

# 선택: 회사·관리자 시드. 아래 SEED_ORG_NAME·SEED_BIZ_REG_NO·SEED_ADMIN_LOGIN_ID·SEED_ADMIN_PASSWORD
# 네 값이 모두 있을 때만 API 시작 시 실행합니다. 같은 사업자등록번호의 회사가 이미 있으면 아무것도 바꾸지 않습니다
# (비밀번호 덮어쓰기 없음). 회사를 더 만들려면 값을 바꿔 다시 시작합니다. 첫 로그인 확인 후 비밀번호 값은 지워도 됩니다.
# 예: SEED_ORG_NAME='오토로그 주식회사' / SEED_BIZ_REG_NO=123-45-67890 / SEED_ADMIN_LOGIN_ID=admin@autolog-demo.kr
SEED_ORG_NAME=
# 형식: 000-00-00000
SEED_BIZ_REG_NO=
# 이메일 형식
SEED_ADMIN_LOGIN_ID=
# 비밀값. BCrypt로 저장되며 로그에 출력하지 않습니다.
SEED_ADMIN_PASSWORD=
# 선택: 대시보드에 표시할 관리자 이름. 비우면 '관리자'
SEED_ADMIN_DISPLAY_NAME=

# Oracle 2 CPU / 약 12GiB 환경에서 시작할 제한값. 예약량이 아니라 컨테이너 사용 상한입니다.
API_MEMORY_LIMIT=1536m
API_CPUS=1.0
DB_MEMORY_LIMIT=512m
DB_CPUS=0.5

# 선택: JVM 설정을 바꾸려는 경우에만 주석을 해제합니다.
# JAVA_TOOL_OPTIONS='-XX:MaxRAMPercentage=70.0 -XX:InitialRAMPercentage=20.0 -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8'

# 이미지 버전은 deploy.sh/Actions가 AUTOLOG_API_IMAGE로 전달하고 .state/에 기록합니다.
# 이 파일에는 SSH 키, GitHub/GHCR 토큰을 넣지 않습니다.
