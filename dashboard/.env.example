# AutoLog 관리자 대시보드 환경변수 예시
# 이 파일을 .env.local로 복사해 값을 바꿉니다. (.env.local은 git에 올라가지 않습니다)
# Vite는 VITE_로 시작하는 값만 빌드 결과물(브라우저 코드)에 넣습니다. 비밀값을 넣지 마세요.

# API Base URL. /api/v1까지 포함합니다.
# - 비워 두면 /api/v1 을 사용하고, 개발 서버(npm run dev)는 Vite 프록시로 http://localhost:8080 에 전달합니다.
# - 운영(Cloudflare Pages) 빌드: https://autolog-api.aihub.io.kr/api/v1
#   이때 서버 CORS_ALLOWED_ORIGINS에 대시보드 도메인이 있어야 합니다.
VITE_API_BASE_URL=

# (개발 서버 전용, VITE_ 아님) Vite 프록시가 연결할 서버 주소. 기본 http://localhost:8080
# AUTOLOG_SERVER_URL=http://localhost:8080
